pkgbase = tide-island-extended
	pkgdesc = Dynamic Island widget and system companion for Wayland compositors (Hyprland & Niri)
	pkgver = 1.1.3
	pkgrel = 1
	url = https://github.com/Bimbok/Tide-island-extended
	install = tide-island-extended.install
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = cmake
	makedepends = ninja
	makedepends = pkgconf
	makedepends = qt6-base
	makedepends = qt6-declarative
	makedepends = qt6-5compat
	makedepends = systemd-libs
	depends = cava
	depends = cliphist
	depends = libdrm
	depends = libpulse
	depends = mesa
	depends = networkmanager
	depends = pipewire
	depends = polkit
	depends = psmisc
	depends = python
	depends = qt6-5compat
	depends = qt6-base
	depends = qt6-declarative
	depends = qt6-shadertools
	depends = qt6-svg
	depends = qt6-wayland
	depends = quickshell
	depends = systemd-libs
	depends = wayland
	depends = wayland-protocols
	depends = wireplumber
	depends = wl-clipboard
	optdepends = bluez: Bluetooth device management
	optdepends = bluez-utils: Bluetooth command-line pairing support
	optdepends = brightnessctl: Display brightness controls
	optdepends = grim: Screen capture backend
	optdepends = hyprland: Wayland compositor support
	optdepends = hyprlock: Hyprland session lock integration
	optdepends = hyprshot: Hyprland screenshot utility
	optdepends = niri: Scrollable-tiling Wayland compositor support
	optdepends = power-profiles-daemon: Power profile switching
	optdepends = slurp: Screen area selector for screenshots
	optdepends = upower: Battery monitoring support
	optdepends = zenity: GUI file and folder picker dialog fallback
	provides = tide-island
	conflicts = tide-island
	conflicts = tide-island-git
	conflicts = tide-island-bin
	conflicts = tide-island-extended-git
	options = !debug

pkgname = tide-island-extended
