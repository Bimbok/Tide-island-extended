#!/bin/bash
# Launcher for Tide Island Quickshell component

# Resolve resources relative to the installed launcher. This keeps system
# installs under /usr and unprivileged installs under ~/.local self-contained.
LAUNCHER_PATH="$(readlink -f "$0")"
INSTALL_PREFIX="$(dirname "$(dirname "$LAUNCHER_PATH")")"
QML_PATH="${TIDE_ISLAND_QML_PATH:-$INSTALL_PREFIX/share/tide-island}"
CONFIG_APP="${TIDE_ISLAND_CONFIG_APP:-$INSTALL_PREFIX/bin/tide-island-config-app}"
QML_MODULE_PATH="$INSTALL_PREFIX/@CMAKE_INSTALL_LIBDIR@/qt6/qml"
if [[ "$QML_MODULE_PATH" == *"@CMAKE_INSTALL_LIBDIR@"* ]]; then
  if [[ -d "$INSTALL_PREFIX/lib/qt6/qml" ]]; then
    QML_MODULE_PATH="$INSTALL_PREFIX/lib/qt6/qml"
  elif [[ -d "$INSTALL_PREFIX/lib64/qt6/qml" ]]; then
    QML_MODULE_PATH="$INSTALL_PREFIX/lib64/qt6/qml"
  else
    QML_MODULE_PATH="${TIDE_ISLAND_QML_MODULE_PATH:-}"
  fi
fi
SERVICE_NAME="tide-island.service"

export QML_IMPORT_PATH="$QML_MODULE_PATH${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"
export QUICKSHELL_LYRICS_BACKEND="${QUICKSHELL_LYRICS_BACKEND:-$QML_PATH/bin/lyricsmpris}"
# Quickshell uses jemalloc. Reclaim released Loader/image allocations in the
# background instead of keeping their high-water mark resident indefinitely.
export MALLOC_CONF="${MALLOC_CONF:-narenas:2,background_thread:true,dirty_decay_ms:2000,muzzy_decay_ms:2000}"

cmd_basename="$(basename "$0")"
if [[ "$cmd_basename" == "tide-island-lock" || "$1" == "--lock" || "$1" == "-l" || "$1" == "lock" ]]; then
  # 1. Try targeting running quickshell instance directly by PID
  running_pid="$(pgrep -u "$(id -u)" -f "quickshell.*tide-island" | head -n 1)"
  if [[ -n "$running_pid" ]]; then
    if /usr/bin/quickshell ipc --pid "$running_pid" call lock lock >/dev/null 2>&1; then
      exit 0
    fi
  fi

  # 2. Fallback to path-based IPC across known install locations
  for test_path in "$QML_PATH" "/usr/share/tide-island" "/usr/local/share/tide-island" "${HOME}/.local/share/tide-island"; do
    if [[ -d "$test_path" ]]; then
      if /usr/bin/quickshell ipc --any-display -p "$test_path" call lock lock >/dev/null 2>&1; then
        exit 0
      fi
    fi
  done

  # 3. If no active instance was reachable, launch standalone lockscreen
  for lock_qml in "$QML_PATH/qml/lockscreen/Lockscreen.qml" "/usr/share/tide-island/qml/lockscreen/Lockscreen.qml" "/usr/local/share/tide-island/qml/lockscreen/Lockscreen.qml"; do
    if [[ -f "$lock_qml" ]]; then
      export LOCK_NOW=1
      exec /usr/bin/quickshell -p "$lock_qml"
    fi
  done
  exit 1
fi

if [[ "${SYSTEMD_EXEC_PID:-}" != "$$" ]]; then
  running_pid="$(pgrep -u "$(id -u)" -f "quickshell.*tide-island" | head -n 1)"
  if [[ -n "$running_pid" ]]; then
    if /usr/bin/quickshell ipc --pid "$running_pid" call island show >/dev/null 2>&1; then
      exit 0
    fi
  fi
  for test_path in "$QML_PATH" "/usr/share/tide-island" "/usr/local/share/tide-island"; do
    if [[ -d "$test_path" ]]; then
      if /usr/bin/quickshell ipc --any-display -p "$test_path" call island show >/dev/null 2>&1; then
        exit 0
      fi
    fi
  done
fi

# Auto-discover Niri socket if running on Niri but NIRI_SOCKET is not in env
if [[ -z "${NIRI_SOCKET:-}" ]]; then
  for s in /run/user/"$(id -u)"/niri*.sock; do
    if [[ -S "$s" ]]; then
      export NIRI_SOCKET="$s"
      break
    fi
  done
fi

desktop_name=":${XDG_CURRENT_DESKTOP,,}:"
compositor_override="${TIDE_ISLAND_COMPOSITOR,,}"
if [[ "$compositor_override" == "niri" ]] \
    || [[ -z "$compositor_override" && "$desktop_name" == *":niri:"* ]] \
    || [[ -z "$compositor_override" && "$desktop_name" != *":hyprland:"* && -n "${NIRI_SOCKET:-}" ]]; then
  "$CONFIG_APP" --ensure-niri-shortcuts || true
fi

exec /usr/bin/quickshell -p "$QML_PATH" "$@"
